# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# zip artifacts (local exports)
*.zip

# env files — real secrets stay untracked. .env.example is the placeholder template.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local
supabase/.temp/
.claude/

# transient entry-price backfill work files (batches + picks)
scripts/backfill-work/
scripts/.backfill-entry-prices.checkpoint.json

# e2e verifier output and captured login state
/verify-output/
verify-storage.json
